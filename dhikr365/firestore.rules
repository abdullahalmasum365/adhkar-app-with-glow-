rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Adhkaar 365 — Firestore Security Rules
    // Security-First Architecture:
    // 1. Strict Owner Authentication: Only request.auth.uid == userId can access.
    // 2. All user subcollections (plan, progress, settings, preferences) are
    //    strictly readable & writable by the account owner.
    // 3. Default Deny: All unspecified collections or root paths are blocked.
    // =========================================================================

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Root user document (users/{userId})
    match /users/{userId} {
      // Owner can read, write, and delete their root document
      allow read, write, delete: if isOwner(userId);

      // ── Custom Dua Plan (users/{userId}/plan/{docId}) ─────────────────────
      match /plan/{docId} {
        allow read, write, delete: if isOwner(userId);
      }

      // ── Progress & Streaks (users/{userId}/progress/{docId}) ───────────────
      match /progress/{docId} {
        allow read, write, delete: if isOwner(userId);
      }

      // ── User Settings & Preferences (users/{userId}/settings/{docId}) ──────
      // Stores user's theme palette, language codes, font sizes, etc.
      match /settings/{docId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Wildcard subcollection support for owner
      match /{allSubcollections=**} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Default deny: Block all other database collections and root paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
