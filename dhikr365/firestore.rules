rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Adhkaar 365 — Firestore Security Rules
    // Security-First: Ensures zero unauthorized access or cross-user leaks.
    // =========================================================================

    // Users collection:
    // Only the authenticated owner of the account can read or write their own documents.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections (e.g., users/{userId}/plan/data)
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny: Block all other database collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
