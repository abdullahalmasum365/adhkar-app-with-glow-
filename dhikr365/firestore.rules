rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for strict authentication & ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Root user document and all nested subcollections:
    // - users/{userId} (Profile document)
    // - users/{userId}/settings/{settingId} (theme, language, notification preferences)
    // - users/{userId}/plan/{planId} (Custom adhkar plans & routine)
    // - users/{userId}/progress/{progressId} (Daily counts, completion history, streaks)
    // - users/{userId}/dedications/{dedicationId} (Sadaqah Jariyah dedications & certificates)
    // - users/{userId}/sadaqah/{docId} (Sponsorship status & active tiers)
    // - users/{userId}/purchases/{purchaseId} (Verified purchase audit logs)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Recursive match for all subcollections under the user's private namespace
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explicitly deny any read/write access to any document outside /users
    match /{document=**} {
      allow read, write: false;
    }
  }
}
